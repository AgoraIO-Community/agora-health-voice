# With all six voice settings blank, the page opens in setup mode.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
MURF_API_KEY=
# HTTPS tunnel origin only, for example https://example.trycloudflare.com
TOOL_CALLBACK_ORIGIN=

HEALTH_DATA_PROVIDER=synthetic
HEALTH_TIME_ZONE=UTC
LOCAL_PORT=3000
CALLBACK_PORT=3001

# Optional terminal callback diagnostics. Values and credentials stay excluded.
HEALTH_DEBUG=false
