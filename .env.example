# With all six voice settings blank, the page opens in setup mode.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
MURF_API_KEY=
# HTTPS tunnel origin only, for example https://example.trycloudflare.com
TOOL_CALLBACK_ORIGIN=

HEALTH_DATA_PROVIDER=synthetic
HEALTH_TIME_ZONE=Asia/Kolkata
LOCAL_PORT=3000
CALLBACK_PORT=3001

# Optional terminal callback diagnostics. Values and credentials stay excluded.
HEALTH_DEBUG=false

# Optional server-only override. Normally Garmin uses the owner-only local file
# ~/.config/garmin/connect-personal-api-key. Leave this variable UNSET to use it.
# GARMIN_PERSONAL_API_KEY=

# Optional temporary HTTPS mobile testing; leave BOTH unset for localhost only.
# Exact browser origin, with no trailing slash; distinct from TOOL_CALLBACK_ORIGIN.
# MOBILE_BROWSER_ORIGIN=https://your-browser-tunnel.trycloudflare.com
# Generate a separate random passcode; see README. Never put it in a URL.
# MOBILE_BROWSER_PASSCODE=
